# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Service (FastAPI on Railway)
AI_SERVICE_URL=https://your-ai-service.railway.app

# LLM APIs
GROQ_API_KEY=gsk_your_groq_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# Email (Resend — https://resend.com)
# Get a free API key at resend.com. Without a key, emails are silently skipped.
# For testing without domain verification, leave RESEND_FROM_EMAIL unset (uses onboarding@resend.dev).
# For production, verify your domain and set: BookFlow <noreply@yourdomain.com>
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=BookFlow <noreply@bookflow.app>

# App
NEXT_PUBLIC_APP_URL=https://bookflow.vercel.app
