{
  "$schema": "https://schemas.tokens.studio/1.0/token-schema.json",
  "$metadata": {
    "tokenSetOrder": ["core", "semantic", "component"]
  },
  "core": {
    "color": {
      "midnight": {
        "50":  { "$value": "#eef2ff", "$type": "color" },
        "100": { "$value": "#e0e7ff", "$type": "color" },
        "200": { "$value": "#c7d2fe", "$type": "color" },
        "300": { "$value": "#a5b4fc", "$type": "color" },
        "400": { "$value": "#818cf8", "$type": "color" },
        "500": { "$value": "#6366f1", "$type": "color" },
        "600": { "$value": "#4f46e5", "$type": "color" },
        "700": { "$value": "#4338ca", "$type": "color" },
        "800": { "$value": "#3730a3", "$type": "color" },
        "900": { "$value": "#0d1526", "$type": "color" },
        "950": { "$value": "#060c1a", "$type": "color" }
      },
      "teal": {
        "400": { "$value": "#2dd4bf", "$type": "color" },
        "500": { "$value": "#14b8a6", "$type": "color" }
      },
      "violet": {
        "400": { "$value": "#a78bfa", "$type": "color" },
        "500": { "$value": "#8b5cf6", "$type": "color" }
      },
      "green":  { "400": { "$value": "#4ade80", "$type": "color" } },
      "blue":   { "400": { "$value": "#60a5fa", "$type": "color" } },
      "amber":  { "400": { "$value": "#fbbf24", "$type": "color" } },
      "rose":   { "400": { "$value": "#fb7185", "$type": "color" } },
      "red":    { "400": { "$value": "#f87171", "$type": "color" } }
    },
    "spacing": {
      "0":   { "$value": "0px",   "$type": "spacing" },
      "1":   { "$value": "4px",   "$type": "spacing" },
      "2":   { "$value": "8px",   "$type": "spacing" },
      "3":   { "$value": "12px",  "$type": "spacing" },
      "4":   { "$value": "16px",  "$type": "spacing" },
      "5":   { "$value": "20px",  "$type": "spacing" },
      "6":   { "$value": "24px",  "$type": "spacing" },
      "8":   { "$value": "32px",  "$type": "spacing" },
      "10":  { "$value": "40px",  "$type": "spacing" },
      "12":  { "$value": "48px",  "$type": "spacing" },
      "16":  { "$value": "64px",  "$type": "spacing" },
      "20":  { "$value": "80px",  "$type": "spacing" },
      "24":  { "$value": "96px",  "$type": "spacing" }
    },
    "borderRadius": {
      "sm":   { "$value": "6px",    "$type": "borderRadius" },
      "md":   { "$value": "8px",    "$type": "borderRadius" },
      "lg":   { "$value": "10px",   "$type": "borderRadius" },
      "xl":   { "$value": "12px",   "$type": "borderRadius" },
      "2xl":  { "$value": "16px",   "$type": "borderRadius" },
      "3xl":  { "$value": "24px",   "$type": "borderRadius" },
      "full": { "$value": "9999px", "$type": "borderRadius" }
    },
    "fontSize": {
      "xs":   { "$value": "10px", "$type": "fontSizes" },
      "sm":   { "$value": "12px", "$type": "fontSizes" },
      "base": { "$value": "14px", "$type": "fontSizes" },
      "md":   { "$value": "16px", "$type": "fontSizes" },
      "lg":   { "$value": "18px", "$type": "fontSizes" },
      "xl":   { "$value": "20px", "$type": "fontSizes" },
      "2xl":  { "$value": "24px", "$type": "fontSizes" },
      "3xl":  { "$value": "32px", "$type": "fontSizes" },
      "4xl":  { "$value": "40px", "$type": "fontSizes" },
      "5xl":  { "$value": "48px", "$type": "fontSizes" },
      "6xl":  { "$value": "64px", "$type": "fontSizes" }
    },
    "fontWeight": {
      "regular":   { "$value": 400, "$type": "fontWeights" },
      "medium":    { "$value": 500, "$type": "fontWeights" },
      "semibold":  { "$value": 600, "$type": "fontWeights" },
      "bold":      { "$value": 700, "$type": "fontWeights" },
      "extrabold": { "$value": 800, "$type": "fontWeights" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2,  "$type": "lineHeights" },
      "normal":  { "$value": 1.5,  "$type": "lineHeights" },
      "relaxed": { "$value": 1.75, "$type": "lineHeights" }
    },
    "fontFamily": {
      "sans":   { "$value": "Inter, system-ui, sans-serif",              "$type": "fontFamilies" },
      "arabic": { "$value": "Noto Sans Arabic, system-ui, sans-serif",   "$type": "fontFamilies" },
      "mono":   { "$value": "JetBrains Mono, monospace",                 "$type": "fontFamilies" }
    },
    "boxShadow": {
      "sm":      { "$value": "0 1px 3px rgba(0,0,0,0.4)",                         "$type": "boxShadow" },
      "md":      { "$value": "0 4px 12px rgba(0,0,0,0.5)",                         "$type": "boxShadow" },
      "primary": { "$value": "0 8px 32px rgba(107,127,255,0.25)",                  "$type": "boxShadow" },
      "glass":   { "$value": "0 4px 24px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05)", "$type": "boxShadow" }
    }
  },
  "semantic": {
    "color": {
      "background":        { "$value": "{core.color.midnight.950}", "$type": "color" },
      "surface":           { "$value": "{core.color.midnight.900}", "$type": "color" },
      "surfaceElevated":   { "$value": "#111d30",                   "$type": "color" },
      "border":            { "$value": "#1e2d45",                   "$type": "color" },
      "borderFocus":       { "$value": "rgba(107,127,255,0.6)",     "$type": "color" },
      "textPrimary":       { "$value": "#e2e8f0",                   "$type": "color" },
      "textSecondary":     { "$value": "#94a3b8",                   "$type": "color" },
      "textMuted":         { "$value": "#64748b",                   "$type": "color" },
      "brand":             { "$value": "#6b7fff",                   "$type": "color" },
      "brandHover":        { "$value": "#5a6fef",                   "$type": "color" },
      "brandForeground":   { "$value": "{core.color.midnight.950}", "$type": "color" },
      "accent":            { "$value": "{core.color.teal.400}",     "$type": "color" },
      "ai":                { "$value": "{core.color.violet.400}",   "$type": "color" },
      "success":           { "$value": "{core.color.green.400}",    "$type": "color" },
      "warning":           { "$value": "{core.color.amber.400}",    "$type": "color" },
      "danger":            { "$value": "{core.color.red.400}",      "$type": "color" },
      "wishlist":          { "$value": "{core.color.rose.400}",     "$type": "color" }
    },
    "condition": {
      "new":        { "$value": "{core.color.green.400}", "$type": "color" },
      "good":       { "$value": "{core.color.blue.400}",  "$type": "color" },
      "acceptable": { "$value": "{core.color.amber.400}", "$type": "color" },
      "poor":       { "$value": "{core.color.red.400}",   "$type": "color" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background":   { "$value": "{semantic.color.brand}",           "$type": "color" },
        "text":         { "$value": "{semantic.color.brandForeground}",  "$type": "color" },
        "borderRadius": { "$value": "{core.borderRadius.xl}",            "$type": "borderRadius" },
        "paddingX":     { "$value": "{core.spacing.4}",                  "$type": "spacing" },
        "paddingY":     { "$value": "{core.spacing.2}",                  "$type": "spacing" }
      },
      "ai": {
        "background":   { "$value": "rgba(167,139,250,0.15)", "$type": "color" },
        "text":         { "$value": "{semantic.color.ai}",    "$type": "color" },
        "border":       { "$value": "rgba(167,139,250,0.3)",  "$type": "color" }
      }
    },
    "card": {
      "background":  { "$value": "rgba(13,21,38,0.8)",  "$type": "color" },
      "border":      { "$value": "rgba(30,45,69,0.6)",  "$type": "color" },
      "borderRadius":{ "$value": "{core.borderRadius.xl}", "$type": "borderRadius" },
      "blur":        { "$value": "12px",                "$type": "other" }
    },
    "input": {
      "background":  { "$value": "rgba(26,37,64,0.4)",  "$type": "color" },
      "border":      { "$value": "{semantic.color.border}", "$type": "color" },
      "borderRadius":{ "$value": "{core.borderRadius.xl}", "$type": "borderRadius" },
      "text":        { "$value": "{semantic.color.textPrimary}", "$type": "color" }
    },
    "badge": {
      "sale": {
        "background": { "$value": "rgba(107,127,255,0.1)", "$type": "color" },
        "text":       { "$value": "{semantic.color.brand}", "$type": "color" }
      },
      "exchange": {
        "background": { "$value": "rgba(45,212,191,0.1)",  "$type": "color" },
        "text":       { "$value": "{semantic.color.accent}", "$type": "color" }
      }
    },
    "header": {
      "height":      { "$value": "64px", "$type": "sizing" },
      "background":  { "$value": "rgba(6,12,26,0.95)", "$type": "color" },
      "blur":        { "$value": "12px",  "$type": "other" }
    }
  }
}
